# Cloudflare Configuration for MedCon

CLOUDFLARE_ENABLED=true

# Use a scoped API token with Zone Settings Edit, Cache Purge, and WAF edit.
CLOUDFLARE_API_KEY=replace_with_a_scoped_api_token
CLOUDFLARE_ZONE_ID=replace_with_your_zone_id
CLOUDFLARE_EMAIL=not_used_with_api_tokens

# Optional Turnstile keys for an interactive challenge widget.
CLOUDFLARE_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
CLOUDFLARE_TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key


