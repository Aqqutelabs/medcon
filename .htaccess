RewriteEngine On

# Redirect browser requests for PHP pages to their extensionless URL.
# Restrict this to GET/HEAD so form submissions and webhooks keep their method.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[?\s]) [NC]
RewriteCond %{REQUEST_URI} ^(.+)\.php$ [NC]
RewriteRule ^ %1 [R=301,L,NE]

RewriteRule ^\.env(?:\.|$) - [F,L]
RewriteRule ^accreditation/?$ accreditation.php [L,QSA]
RewriteRule ^a/([A-Za-z0-9-]+)/?$ referral.php?name=$1 [L,QSA]

# Serve an existing PHP page when its extensionless URL is requested.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]
